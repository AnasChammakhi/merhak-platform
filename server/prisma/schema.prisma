generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS
// ============================================================

model User {
  id       Int      @id @default(autoincrement())
  name     String   @db.VarChar(200)
  email    String?  @unique @db.VarChar(255)
  password String?  @db.VarChar(255) // nullable: admin can create a client without login access
  phone    String?  @db.VarChar(30)
  address  String?  @db.VarChar(255)
  role     UserRole @default(CLIENT)

  measurements Measurement[]
  orders       Order[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

enum UserRole {
  CLIENT
  ADMIN
}

// ============================================================
// MEASUREMENTS (mesures)
// ============================================================

model Measurement {
  id       Int    @id @default(autoincrement())
  clientId Int    @map("client_id")
  client   User   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label    String @db.VarChar(100) // e.g. "Moi", "Ami Ahmed"

  chestCirc   Decimal? @map("chest_circ") @db.Decimal(6, 2) // T.Poitrine
  waistCirc   Decimal? @map("waist_circ") @db.Decimal(6, 2) // T.Taille
  hipCirc     Decimal? @map("hip_circ") @db.Decimal(6, 2) // T.Hanche
  armCirc     Decimal? @map("arm_circ") @db.Decimal(6, 2) // T.Bras
  wristCirc   Decimal? @map("wrist_circ") @db.Decimal(6, 2) // T.Poignet
  frontSquare Decimal? @map("front_square") @db.Decimal(6, 2) // L.Carr DVT
  backSquare  Decimal? @map("back_square") @db.Decimal(6, 2) // L.Carr DOS
  shoulderLen Decimal? @map("shoulder_len") @db.Decimal(6, 2) // L.Epaule
  walkLen     Decimal? @map("walk_len") @db.Decimal(6, 2) // L.Marche
  frontLen    Decimal? @map("front_len") @db.Decimal(6, 2) // L.DVT
  dressLen    Decimal? @map("dress_len") @db.Decimal(6, 2) // L.Robe
  shirtLen    Decimal? @map("shirt_len") @db.Decimal(6, 2) // L.Chemise
  skirtLen    Decimal? @map("skirt_len") @db.Decimal(6, 2) // L.Jupe
  pantsLen    Decimal? @map("pants_len") @db.Decimal(6, 2) // L.Pantalon
  chestLen    Decimal? @map("chest_len") @db.Decimal(6, 2) // L.Poitrine
  other       String?  @db.Text // Autres

  customOrderDetails CustomOrderDetail[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("measurements")
}

// ============================================================
// CATEGORIES (hierarchical: niv1 > niv2 > niv3, unlimited depth)
// ============================================================

model Category {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(255)
  description String? @db.Text

  parentId Int?       @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")

  products Product[]

  @@map("categories")
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id            Int      @id @default(autoincrement())
  categoryId    Int      @map("category_id")
  category      Category @relation(fields: [categoryId], references: [id])
  name          String   @db.VarChar(255)
  description   String?  @db.Text
  price         Decimal  @db.Decimal(10, 2) // prix de vente
  cost          Decimal  @db.Decimal(10, 2) // coût de revient — pour les stats de profit
  fabricType    String?  @map("fabric_type") @db.VarChar(100) // lin, coton...
  deliveryCost  Decimal? @map("delivery_cost") @db.Decimal(10, 2)
  packagingCost Decimal? @map("packaging_cost") @db.Decimal(10, 2)
  stock         Int?     @default(0) // used only if product has no variants
  active        Boolean  @default(true)

  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String  @db.VarChar(255)

  @@map("product_images")
}

// A product can have many size/color combinations (e.g. Pantalon -> S/M/L/XL or 38/40/42, each in several colors)
model ProductVariant {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String   @db.VarChar(20) // "S","M","L","XL" or "38","40","42"...
  color      String   @db.VarChar(50) // "Bleu","Blanc"...
  stock      Int      @default(0)
  extraPrice Decimal? @map("extra_price") @db.Decimal(10, 2) // optional surcharge for this variant
  sku        String?  @unique @db.VarChar(100)

  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@map("product_variants")
}

// ============================================================
// ORDERS (commandes)
// ============================================================

model Order {
  id       Int   @id @default(autoincrement())
  clientId Int?  @map("client_id") // null if not logged in
  client   User? @relation(fields: [clientId], references: [id])

  // Snapshot at order time — auto-filled if logged in, manual otherwise
  firstName String @map("first_name") @db.VarChar(255)
  lastName  String @map("last_name") @db.VarChar(255)
  phone     String @db.VarChar(30)
  address   String @db.VarChar(255)

  type   OrderType   @default(STANDARD)
  status OrderStatus @default(NEW)
  note   String?     @db.Text

  totalPrice Decimal @map("total_price") @db.Decimal(10, 2)

  items         OrderItem[]
  customDetail  CustomOrderDetail?
  financeEntries FinanceEntry[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("orders")
}

enum OrderType {
  STANDARD
  CUSTOM // sur-mesure
}

enum OrderStatus {
  NEW         // nouvelle
  CONFIRMED   // confirmee
  IN_PROGRESS // en_cours
  READY       // prete
  DELIVERED   // livree
  CANCELLED   // annulee
}

model OrderItem {
  id        Int             @id @default(autoincrement())
  orderId   Int             @map("order_id")
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int             @map("product_id")
  product   Product         @relation(fields: [productId], references: [id])
  variantId Int?            @map("variant_id") // which size/color was picked, if applicable
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal         @map("unit_price") @db.Decimal(10, 2)

  @@map("order_items")
}

// ============================================================
// CUSTOM ORDER DETAILS (sur_mesure_details)
// ============================================================

model CustomOrderDetail {
  id            Int         @id @default(autoincrement())
  orderId       Int         @unique @map("order_id")
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  measurementId Int         @map("measurement_id")
  measurement   Measurement @relation(fields: [measurementId], references: [id], onDelete: Restrict)

  articleName String  @map("article_name") @db.VarChar(255) // nom d'article (ex: "Robe de soirée")
  note        String? @db.Text

  fabricProvidedByClient Boolean  @default(false) @map("fabric_provided_by_client")
  fabricPricePerMeter    Decimal? @map("fabric_price_per_meter") @db.Decimal(10, 2)
  metersNeeded           Decimal? @map("meters_needed") @db.Decimal(6, 2)
  fabricTotalPrice       Decimal? @map("fabric_total_price") @db.Decimal(10, 2)

  subcontractingCost Decimal @map("subcontracting_cost") @db.Decimal(10, 2)
  laborCost          Decimal @map("labor_cost") @db.Decimal(10, 2)
  recommendedPrice   Decimal @map("recommended_price") @db.Decimal(10, 2)
  finalPrice         Decimal @map("final_price") @db.Decimal(10, 2)

  depositAmount Decimal?  @map("deposit_amount") @db.Decimal(10, 2) // acompte
  depositDate   DateTime? @map("deposit_date")

  imageUrl String? @map("image_url") @db.VarChar(255)

  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  deliveryDate DateTime @map("delivery_date")

  @@map("custom_order_details")
}

// ============================================================
// CONTACT
// ============================================================

model ContactMessage {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(255)
  email   String  @db.VarChar(255)
  phone   String? @db.VarChar(30)
  message String  @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

// ============================================================
// EXPENSES (depenses)
// ============================================================

model Expense {
  id     Int         @id @default(autoincrement())
  label  String      @db.VarChar(150) // loyer, patente, steg, chaise de bureau...
  type   ExpenseType // RECURRING or ONE_TIME
  amount Decimal     @db.Decimal(10, 2)

  date      DateTime? // for ONE_TIME
  startDate DateTime? @map("start_date") // for RECURRING
  endDate   DateTime? @map("end_date") // for RECURRING, null = toujours actif

  description String? @db.Text

  financeEntries FinanceEntry[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("expenses")
}

enum ExpenseType {
  RECURRING
  ONE_TIME
}

// ============================================================
// FINANCE (ledger / historique — every money movement gets a row here)
// ============================================================

model FinanceEntry {
  id          Int              @id @default(autoincrement())
  type        FinanceEntryType
  direction   FinanceDirection // INCOME or EXPENSE
  amount      Decimal          @db.Decimal(10, 2)
  date        DateTime         @default(now()) // actual date of the transaction (can be backdated)
  description String?          @db.Text

  // Optional links back to the source of this entry — only one will be set depending on `type`
  orderId   Int?     @map("order_id")
  order     Order?   @relation(fields: [orderId], references: [id])
  expenseId Int?     @map("expense_id")
  expense   Expense? @relation(fields: [expenseId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("finance_entries")
}

enum FinanceEntryType {
  SALE         // vente produit standard
  CUSTOM_ORDER // vente sur-mesure (prix final)
  DEPOSIT      // acompte reçu
  EXPENSE      // sortie liée à une dépense (récurrente ou ponctuelle)
  REFUND
  OTHER
}

enum FinanceDirection {
  INCOME
  EXPENSE
}
